{
  "darwin": {
    "runtime": "{home}/Library/Caches/chrome-control/runtime",
    "tmp": "{home}/tmp/chrome-control",
    "roots": [
      "{home}/Downloads",
      "{home}/Brook/Sync/30_Resources/31_Knowledge_Base/Cam/MPhil"
    ],
    "browser": {
      "mode": "autoConnect"
    },
    "starter": {
      "kind": "direct"
    },
    "profiles": {
      "userDataDir": "{home}/Library/Application Support/Google/Chrome",
      "browser": "default"
    }
  },
  "win32": {
    "runtime": "{LOCALAPPDATA}/chrome-control/runtime",
    "roots": [
      "{home}/Downloads"
    ],
    "browser": {
      "mode": "dedicated",
      "userDataDir": "{LOCALAPPDATA}/chrome-control/profile",
      "executablePath": "C:/Program Files/Google/Chrome/Application/chrome.exe",
      "headless": true,
      "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/{chromeMajor}.0.0.0 Safari/537.36"
    },
    "starter": {
      "kind": "logonTask",
      "name": "chrome-control"
    },
    "browsers": {
      "real": {
        "mode": "autoConnect",
        "userDataDir": "{LOCALAPPDATA}/Google/Chrome/User Data",
        "runtime": "{LOCALAPPDATA}/chrome-control/runtime-real",
        "starter": {
          "kind": "logonTask",
          "name": "chrome-control-real"
        }
      }
    },
    "profiles": {
      "userDataDir": "{LOCALAPPDATA}/Google/Chrome/User Data",
      "browser": "real"
    }
  },
  "linux": {
    "runtime": "{home}/.cache/chrome-control/runtime",
    "tmp": "{home}/tmp/chrome-control",
    "roots": [
      "{home}/Downloads"
    ],
    "browser": {
      "mode": "isolated",
      "executablePath": "/usr/bin/google-chrome"
    },
    "starter": {
      "kind": "direct"
    }
  }
}
