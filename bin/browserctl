#!/usr/bin/env python3
"""Chrome control over authenticated SSH, with explicit account/Profile routing."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent


def help_text(topic=None):
    catalog = json.loads((ROOT / 'config/cli-help.json').read_text())
    if topic:
        if topic not in catalog:
            raise ValueError(f'Unknown help command: {topic}')
        item = catalog[topic]
        return '\n'.join([item['summary'], '', item['usage'], '', *item.get('notes', [])])
    rows = [f"  {name:14} {item['summary']}" for name, item in catalog.items()]
    return '\n'.join(['browserctl：现有 Chrome 的统一 CLI，无需加载 skill 或连接会话 MCP。',
                      '', '用法：browserctl [选项] COMMAND [参数]', '', *rows, '',
                      '选项：--machine MACHINE  --actor TASK  --account EMAIL_OR_ALIAS',
                      '      --profile DIR（与 --account 互斥） --out NAME --timeout SECONDS',
                      '      --identity NOTE  --credentials FILE', '',
                      '按需帮助：browserctl help open / browserctl open --help',
                      '参数契约：browserctl tools TOOL',
                      '快速开始：browserctl --actor my-task --account cambridge open https://www.vle.cam.ac.uk/my/'])


def arguments(targets):
    parser = argparse.ArgumentParser(description=__doc__, add_help=False)
    parser.add_argument('-h', '--help', action='store_true')
    parser.add_argument('--machine', default='zengxiaoximac01', choices=list(targets))
    identity = os.environ.get('CLAUDE_CODE_SESSION_ID') or os.environ.get('TMUX_PANE') or str(os.getppid())
    actor = os.environ.get('CHROME_CONTROL_ACTOR', 'client-' + hashlib.sha256(identity.encode()).hexdigest()[:16])
    parser.add_argument('--actor', default=actor)
    selector = parser.add_mutually_exclusive_group()
    selector.add_argument('--profile', metavar='DIR', help='Explicit Chrome profile directory')
    selector.add_argument('--account', metavar='EMAIL_OR_ALIAS', help='Resolve a registered Chrome email or private account alias')
    parser.add_argument('--out', metavar='NAME', help='download: staged filename in a new isolated directory')
    parser.add_argument('--timeout', type=int, default=120)
    parser.add_argument('--identity', help='download: caller note, not website identity evidence')
    parser.add_argument('--credentials', default=str(Path.home() / '.config/cambridge/credentials'))
    parser.add_argument('command', nargs='?', choices=['targets', 'start', 'stop', 'status', 'capabilities', 'tools', 'profiles', 'download', 'login', 'pages', 'open', 'identity', 'call', 'mcp', 'help'])
    parser.add_argument('tool', nargs='?')
    parser.add_argument('arguments', nargs='?', default='{}')
    args = parser.parse_args()
    if args.help or args.command in (None, 'help'):
        try:
            print(help_text(args.tool if args.command == 'help' else args.command))
        except ValueError as error:
            parser.error(str(error))
        parser.exit()
    validate(parser, args)
    return args


def validate(parser, args):
    if not re.fullmatch(r'[A-Za-z0-9_.:-]{1,100}', args.actor):
        parser.error('Invalid actor')
    if (args.profile or args.account) and args.command not in ('pages', 'call', 'download', 'login', 'open', 'identity', 'mcp'):
        parser.error('--account/--profile applies to pages, call, download, login, open, identity or mcp')
    if args.command in ('call', 'open', 'identity', 'download') and not args.tool:
        parser.error(f'{args.command} requires a tool, URL or page ID')
    if args.command == 'download' and not args.out:
        parser.error('download requires --out NAME')
    if args.command in ('open', 'identity') and not (args.account or args.profile):
        parser.error(f'{args.command} requires --account or --profile')
    if args.command == 'login' and args.account:
        parser.error('login is limited to the dedicated browser, not a personal account')
    try:
        if not isinstance(json.loads(args.arguments), dict):
            parser.error('Arguments must be a JSON object')
    except ValueError:
        parser.error('Invalid JSON arguments')


def remote_command(args, target):
    env = [f'{key}={value}' for key, value in target.get('env', {}).items()]
    remote = (['env', *env] if env else []) + [target['node'], target['root'] + '/interfaces/cli.mjs', args.actor]
    data = json.loads(args.arguments)
    if args.command == 'download':
        data = {'filename': args.out, 'timeoutMs': args.timeout * 1000}
        if args.identity:
            data['identity'] = args.identity
    selector = {'account': args.account} if args.account else {'profile': args.profile} if args.profile else None
    if selector:
        remote += ['scoped', args.command, json.dumps({'protocolVersion': 1, 'selector': selector, 'tool': args.tool, 'arguments': data})]
    else:
        remote += [args.command]
        if args.tool:
            remote += [args.tool]
        if args.command in ('call', 'download'):
            remote += [json.dumps(data)]
    return ['ssh', '-T', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=8', '-o', 'ServerAliveInterval=5', '-o', 'ServerAliveCountMax=2', target['ssh'], shlex.join(remote)]


def execute(args, command):
    timeout = {'mcp': None, 'download': args.timeout + 60, 'login': 420, 'open': 120}.get(args.command, 80)
    stdin = Path(args.credentials).read_bytes() if args.command == 'login' else None
    if args.command == 'mcp':
        return subprocess.run(command, timeout=timeout).returncode
    result = subprocess.run(command, timeout=timeout, input=stdin, capture_output=True)
    if result.stdout:
        sys.stdout.buffer.write(result.stdout)
    if result.stderr:
        sys.stderr.buffer.write(result.stderr)
    if (args.account or args.profile) and result.returncode and b'Expected ' in result.stderr:
        print('Chrome control deployment mismatch: remote lacks account-routing-v1; deploy chrome-control before account operations. No unscoped fallback was attempted.', file=sys.stderr)
    return result.returncode


def main():
    targets = json.loads((ROOT / 'config/targets.json').read_text())
    args = arguments(targets)
    if args.command == 'targets':
        print(json.dumps(targets, indent=2))
        return 0
    try:
        return execute(args, remote_command(args, targets[args.machine]))
    except subprocess.TimeoutExpired:
        print(json.dumps({'error': 'Remote operation timed out; no retry was sent'}), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == '__main__':
    sys.exit(main())
