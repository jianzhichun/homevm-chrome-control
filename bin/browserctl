#!/usr/bin/env python3
"""Unified Chrome control over authenticated SSH; no raw debug port forwarding."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent


def main():
    targets = json.loads((ROOT / "config/targets.json").read_text())
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--machine", default="zengxiaoximac01", choices=list(targets))
    identity = os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("TMUX_PANE") or str(os.getppid())
    actor = os.environ.get("CHROME_CONTROL_ACTOR", "client-" + hashlib.sha256(identity.encode()).hexdigest()[:16])
    parser.add_argument("--actor", default=actor)
    parser.add_argument("--profile", metavar="DIR", help="Chrome profile directory (see: profiles) to target for pages/call/download")
    parser.add_argument("--out", metavar="NAME", help="download: name the collected file in staging")
    parser.add_argument("--timeout", type=int, default=120, help="download: give up after N seconds")
    parser.add_argument("--identity", help="download: note about whose session the download relies on")
    parser.add_argument("--credentials", default=str(Path.home() / ".config/cambridge/credentials"),
                        help="login: owner's credentials file, sent over ssh stdin (never argv)")
    parser.add_argument("command", choices=["targets", "start", "stop", "status", "tools", "profiles", "download", "login", "pages", "call", "mcp"])
    parser.add_argument("tool", nargs="?")
    parser.add_argument("arguments", nargs="?", default="{}")
    args = parser.parse_args()
    if not re.fullmatch(r"[A-Za-z0-9_.:-]{1,100}", args.actor):
        parser.error("Invalid actor")
    if args.command == "targets":
        print(json.dumps(targets, indent=2))
        return 0
    if args.command == "call":
        if not args.tool:
            parser.error("call requires TOOL and optional JSON arguments")
        if not isinstance(json.loads(args.arguments), dict):
            parser.error("Arguments must be a JSON object")
    if args.profile and args.command not in ("pages", "call", "download", "login"):
        parser.error("--profile applies to pages, call, download and login")
    if args.command == "download":
        if not args.tool:
            parser.error("download requires a URL")
        if not args.out:
            parser.error("download requires --out NAME")
    target = targets[args.machine]
    env = [f"{key}={value}" for key, value in target.get("env", {}).items()]
    if args.profile:
        env.append(f"CHROME_CONTROL_PROFILE={args.profile}")
    remote = (["env", *env] if env else []) + [target["node"], target["root"] + "/interfaces/cli.mjs", args.actor, args.command]
    if args.command == "call":
        remote += [args.tool, args.arguments]
    if args.command == "login" and args.tool:
        remote += [args.tool]
    if args.command == "download":
        # cli.mjs <actor> download <url> <json>: the URL rides in the tool
        # slot; download options become its JSON arguments.
        import json as _json
        remote += [args.tool, _json.dumps({
            "filename": args.out,
            "timeoutMs": args.timeout * 1000,
            **({"identity": args.identity} if getattr(args, "identity", None) else {}),
        })]
    ssh = ["ssh", "-T", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", "-o", "ServerAliveInterval=5", "-o", "ServerAliveCountMax=2", target["ssh"], shlex.join(remote)]
    try:
        ssh_timeout = {"mcp": None, "download": args.timeout + 60, "login": 420}.get(args.command, 50)
        stdin = Path(args.credentials).read_bytes() if args.command == "login" else None
        return subprocess.run(ssh, timeout=ssh_timeout, input=stdin).returncode
    except subprocess.TimeoutExpired:
        print(json.dumps({"error": f"Remote operation exceeded {ssh_timeout} seconds; no retry was sent"}), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
